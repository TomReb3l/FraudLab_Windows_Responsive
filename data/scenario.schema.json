{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fraud-lab.local/schema/scenario.schema.json",
  "title": "FRAUD LAB Scenario Bundle",
  "type": "object",
  "required": ["schema_version", "scenarios"],
  "properties": {
    "schema_version": {"type": "string"},
    "scenarios": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["scenario_id", "type", "title", "start_node", "nodes"],
        "properties": {
          "scenario_id": {"type": "string", "minLength": 1},
          "type": {"type": "string", "enum": ["fraud_call", "sms", "fake_website", "ai_trust", "crowd"]},
          "title": {"type": "string"},
          "estimated_seconds": {"type": "integer", "minimum": 30, "maximum": 300},
          "start_node": {"type": "string"},
          "max_score": {"type": "integer", "minimum": 1, "maximum": 100},
          "educational_message": {
            "type": "object",
            "required": ["stop", "check", "verify"],
            "properties": {
              "stop": {"type": "string"},
              "check": {"type": "string"},
              "verify": {"type": "string"}
            }
          },
          "nodes": {
            "type": "object",
            "additionalProperties": {
              "type": "object",
              "required": ["id", "kind", "speaker", "text", "choices", "red_flags", "safe_action", "score_delta", "terminal"],
              "properties": {
                "id": {"type": "string"},
                "kind": {"type": "string", "enum": ["incoming_call", "dialogue", "result"]},
                "speaker": {"type": "string", "enum": ["system", "caller"]},
                "text": {"type": "string"},
                "audio": {"type": ["string", "null"]},
                "pressure_techniques": {
                  "type": "array",
                  "items": {"type": "string", "enum": ["authority", "urgency", "fear", "isolation", "trust", "scarcity"]}
                },
                "choices": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "required": ["label", "next_node", "score_delta", "intent"],
                    "properties": {
                      "label": {"type": "string"},
                      "next_node": {"type": "string"},
                      "score_delta": {"type": "integer"},
                      "intent": {"type": "string"}
                    }
                  }
                },
                "feedback": {"type": ["string", "null"]},
                "red_flags": {"type": "array", "items": {"type": "string"}},
                "safe_action": {"type": "string"},
                "score_delta": {"type": "integer"},
                "terminal": {"type": "boolean"}
              }
            }
          }
        }
      }
    }
  }
}
